<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yeni Nesil PDKS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { 
            background-color: #0f172a; /* Tailwind Slate-900 */
            color: #e2e8f0; 
            font-family: 'Poppins', sans-serif; 
            background-image: radial-gradient(circle at top right, #1e293b, #0f172a);
            min-height: 100vh;
        }
        /* Buzlu Cam Efektli Menü */
        .glass-navbar { 
            background: rgba(30, 41, 59, 0.7) !important; 
            backdrop-filter: blur(12px); 
            border-bottom: 1px solid rgba(255, 255, 255, 0.1); 
        }
        .navbar-brand { font-weight: 700; letter-spacing: 1px; color: #38bdf8 !important; }
        .nav-link { font-weight: 500; color: #cbd5e1 !important; transition: 0.3s; }
        .nav-link:hover { color: #38bdf8 !important; transform: translateY(-2px); }
        
        /* Premium Kart Tasarımı */
        .card { 
            background-color: #1e293b; 
            border: 1px solid rgba(255, 255, 255, 0.05); 
            border-radius: 20px; 
            box-shadow: 0 15px 30px -5px rgba(0,0,0,0.5); 
        }
        
        .footer { border-top: 1px solid rgba(255, 255, 255, 0.1); background-color: transparent !important; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm glass-navbar navbar-dark mb-5 py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-fingerprint me-2 fs-4"></i>NEXUS PDKS
                </a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav ms-auto gap-3">
                        <li class="nav-item">
                            <a class="nav-link" href="/Personel/Index"><i class="fas fa-users me-1"></i> Personel Portalı</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Gecis/Index"><i class="fas fa-microchip me-1"></i> Canlı Turnike</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Gecis/Rapor"><i class="fas fa-database me-1"></i> Sistem Logları</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted py-4 mt-auto">
        <div class="container d-flex justify-content-between align-items-center">
            <span style="color: #64748b;">&copy; 2026 - Nexus Kurumsal Altyapı</span>
            <span class="badge bg-primary bg-opacity-10 text-info px-3 py-2 border border-info border-opacity-25 rounded-pill">
                <i class="fas fa-shield-alt me-2"></i>Sistem Yöneticisi: Mevlüt
            </span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>